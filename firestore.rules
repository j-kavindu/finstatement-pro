rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{uid}/auditLogs/{logId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.actorId == uid && request.resource.data.recordedAt == request.time
        && request.resource.data.action is string && request.resource.data.details is string
        && request.resource.data.action.size() <= 100 && request.resource.data.details.size() <= 500;
      allow update, delete: if false;
    }
    // Small private workspace: optimistic revision protects concurrent sessions.
    match /users/{uid}/workspaces/{workspaceId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid && workspaceId == 'primary'
        && request.resource.data.keys().hasOnly(['payload', 'revision', 'updatedAt'])
        && request.resource.data.payload is map && request.resource.data.revision == 1
        && request.resource.data.updatedAt == request.time;
      allow update: if request.auth != null && request.auth.uid == uid && workspaceId == 'primary'
        && request.resource.data.keys().hasOnly(['payload', 'revision', 'updatedAt'])
        && request.resource.data.payload is map && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

  }
}
