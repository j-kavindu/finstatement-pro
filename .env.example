# Create a Firebase Web App in your own Firebase project.
# These values identify the Firebase project; security depends on Auth and Firestore rules.
VITE_FIREBASE_API_KEY=replace_me
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=replace_me
VITE_FIREBASE_MESSAGING_SENDER_ID=replace_me
